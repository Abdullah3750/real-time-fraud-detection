# Data (never commit raw financial data / large files)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Trained model artifacts (large binary files — regenerate via training scripts)
models/*
!models/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Env / secrets
.env
kaggle.json

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# Docker
*.log
